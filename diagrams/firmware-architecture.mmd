flowchart LR
  IMU["MPU6050 data-ready poll + burst; bounded I2C"] --> CAL["Level accelerometer and gyro offset calibration"]
  CAL --> FIL["DLPF + gravity validity gate"]
  FIL --> EST["Complementary Euler estimator"]
  CB["Wi-Fi callback: peer/length and bounded stop CRC check"] --> Q["Normal + priority emergency mailboxes"]
  Q --> V["CRC/version/range/session/sequence validation"]
  V --> CMD["Pilot angle / yaw-rate / collective commands"]
  CMD --> PID["Outer angle P + inner rate PID"]
  EST --> PID
  PID --> MIX["Configured Quad-X mix; desaturation and finite checks"]
  MIX --> OUT["Gated initialized PWM; pulses only on explicit arming/armed"]
  SAFE["Safety supervisor + optional battery/local permit"] --> PID
  SAFE --> OUT
  V --> SAFE
  EST --> SAFE
  TIME["Interval/execution deadlines + task watchdog"] --> SAFE
  SAFE --> TEL["Snapshot queue; low-priority serial + status"]
  EST --> TEL
  MIX --> TEL
